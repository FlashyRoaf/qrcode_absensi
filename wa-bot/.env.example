WA_BOT_PORT=3000
# Must be identical to WA_BOT_SECRET in the Laravel .env. Without it,
# the bot refuses every /send-* request.
WA_BOT_SECRET=
# Folder containing the weekly-report .xlsx files Laravel generates
# (the same value as WA_BOT_STORAGE_PATH in the Laravel .env).
# File sends are only allowed from this folder.
WA_BOT_STORAGE_PATH=/path/to/storage
